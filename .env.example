# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.taarokh.com      # canonical URL (sitemap, OG, canonical tags)
NEXT_PUBLIC_STORE_MODE=preview                    # "preview" (default) or "live"

# Public business details — leave blank until confirmed; the site shows "to be confirmed"
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Commerce (Shopify Storefront API, hosted checkout) ───────────────
COMMERCE_PROVIDER=shopify
SHOPIFY_STORE_DOMAIN=                              # e.g. taarokh.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# ── Newsletter (first configured provider is used) ───────────────────
MAILCHIMP_API_KEY=                                 # e.g. xxxxxxxx-us21 (double opt-in)
MAILCHIMP_AUDIENCE_ID=
BUTTONDOWN_API_KEY=

# ── Contact form (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=                                  # monitored support inbox
CONTACT_FROM_EMAIL=                                # verified sender, e.g. "TAAROKH <hello@yourdomain>"

# ── Optional spam protection (Cloudflare Turnstile) ──────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cash on Delivery orders (at least one channel required to accept orders) ──
ORDER_WEBHOOK_URL=                                 # POST JSON per order (Google Apps Script → Sheet, Zapier, Make…)
ORDER_TO_EMAIL=                                    # store inbox for order emails (falls back to CONTACT_TO_EMAIL); needs RESEND_API_KEY
NEXT_PUBLIC_SUPPORT_PHONE=+91 7378010000
